# OmniPost nginx 反代配置示例
# 拷贝到 /etc/nginx/sites-available/omnipost，然后：
#   sudo ln -sf /etc/nginx/sites-available/omnipost /etc/nginx/sites-enabled/omnipost
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name _;  # 改成你的域名或 IP

    # 前端静态文件 —— 直接由 nginx 服务，不走任何后端进程
    root /opt/data/omnipost/frontend-dist;
    index index.html;

    # SPA 路由 fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API
    location /api/ {
        proxy_pass http://172.18.0.2:8000;   # 容器内 IP，按实际改
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 10M;            # Excel 上传留余量
        proxy_read_timeout 120s;             # LLM 调用可能慢
    }

    # 静态资源缓存
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
